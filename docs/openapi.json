{
  "openapi": "3.1.0",
  "info": {
    "title": "Telecom Support Agent",
    "description": "Network issue triage & escalation (Azure AI Foundry primary, Groq failover).",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Chat",
        "operationId": "chat_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/classify": {
      "post": {
        "tags": [
          "classify"
        ],
        "summary": "Classify",
        "operationId": "classify_v1_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets": {
      "post": {
        "tags": [
          "tickets"
        ],
        "summary": "Create Ticket",
        "operationId": "create_ticket_v1_tickets_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "List Tickets",
        "operationId": "list_tickets_v1_tickets_get",
        "parameters": [
          {
            "name": "queue",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/EscalationQueue"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Queue"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Priority"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Priority"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TicketStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketOut"
                  },
                  "title": "Response List Tickets V1 Tickets Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tickets/{ticket_id}": {
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "Get Ticket",
        "operationId": "get_ticket_v1_tickets__ticket_id__get",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticket Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/feedback": {
      "post": {
        "tags": [
          "feedback"
        ],
        "summary": "Feedback",
        "operationId": "feedback_v1_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Metrics Endpoint",
        "operationId": "metrics_endpoint_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "customer_ctx": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Ctx"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IssueCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Priority"
              },
              {
                "type": "null"
              }
            ]
          },
          "resolution": {
            "$ref": "#/components/schemas/Resolution"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "type": "array",
            "title": "Citations",
            "default": []
          },
          "ticket": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TicketBrief"
              },
              {
                "type": "null"
              }
            ]
          },
          "llm": {
            "$ref": "#/components/schemas/LlmInfoOut"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageOut"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "session_id",
          "resolution",
          "answer",
          "llm",
          "usage"
        ],
        "title": "ChatResponse"
      },
      "CitationOut": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "title",
          "section"
        ],
        "title": "CitationOut"
      },
      "ClassifyRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ClassifyRequest"
      },
      "ClassifyResponse": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/IssueCategory"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "entities": {
            "additionalProperties": true,
            "type": "object",
            "title": "Entities",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "category",
          "priority",
          "confidence"
        ],
        "title": "ClassifyResponse"
      },
      "EscalationQueue": {
        "type": "string",
        "enum": [
          "NOC_L2",
          "BILLING_OPS",
          "SIM_PROVISIONING",
          "ROAMING_PARTNER_DESK",
          "RETENTION",
          "GENERAL_L1"
        ],
        "title": "EscalationQueue"
      },
      "FeedbackRequest": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "default": ""
          },
          "thumbs": {
            "type": "string",
            "pattern": "^(up|down)$",
            "title": "Thumbs"
          },
          "comment": {
            "type": "string",
            "title": "Comment",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "thumbs"
        ],
        "title": "FeedbackRequest"
      },
      "FeedbackResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "accepted": {
            "type": "boolean",
            "title": "Accepted",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "FeedbackResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IssueCategory": {
        "type": "string",
        "enum": [
          "NETWORK_COVERAGE",
          "DATA_SLOW",
          "CALL_DROP",
          "BILLING_DISPUTE",
          "RECHARGE_PAYMENT_FAILED",
          "SIM_ACTIVATION",
          "SIM_SWAP_PORTING",
          "ROAMING",
          "VAS_SUBSCRIPTION",
          "DEVICE_CONFIG",
          "ACCOUNT_KYC",
          "OTHER"
        ],
        "title": "IssueCategory"
      },
      "LlmInfoOut": {
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "alias": {
            "type": "string",
            "title": "Alias",
            "default": "chat-main"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "provider"
        ],
        "title": "LlmInfoOut"
      },
      "Priority": {
        "type": "string",
        "enum": [
          "P1",
          "P2",
          "P3",
          "P4"
        ],
        "title": "Priority",
        "description": "P1 no service / suspected outage · P2 severely degraded ·\nP3 billing or provisioning dispute · P4 informational."
      },
      "Provider": {
        "type": "string",
        "enum": [
          "AZURE_FOUNDRY",
          "GROQ",
          "FAKE"
        ],
        "title": "Provider"
      },
      "Resolution": {
        "type": "string",
        "enum": [
          "RESOLVED",
          "NEEDS_INFO",
          "ESCALATED"
        ],
        "title": "Resolution"
      },
      "TicketBrief": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "queue": {
            "type": "string",
            "title": "Queue"
          },
          "priority": {
            "type": "string",
            "title": "Priority"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "queue",
          "priority",
          "status"
        ],
        "title": "TicketBrief"
      },
      "TicketCreate": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "category": {
            "$ref": "#/components/schemas/IssueCategory"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "queue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EscalationQueue"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "title": "Summary",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "category",
          "priority"
        ],
        "title": "TicketCreate"
      },
      "TicketOut": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "category": {
            "$ref": "#/components/schemas/IssueCategory"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "queue": {
            "$ref": "#/components/schemas/EscalationQueue"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "session_id",
          "category",
          "priority",
          "queue",
          "status",
          "summary"
        ],
        "title": "TicketOut"
      },
      "TicketStatus": {
        "type": "string",
        "enum": [
          "OPEN",
          "IN_PROGRESS",
          "RESOLVED",
          "CLOSED"
        ],
        "title": "TicketStatus"
      },
      "UsageOut": {
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "default": 0
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens",
            "default": 0
          },
          "est_cost_usd": {
            "type": "number",
            "title": "Est Cost Usd",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "UsageOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
